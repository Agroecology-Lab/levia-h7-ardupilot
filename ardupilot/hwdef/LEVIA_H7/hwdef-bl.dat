# Minimal bring-up bootloader definition for LEVIA H7

MCU STM32H7xx STM32H743xx

# Provisional LEVIA H7 ID. Reserve this ID in ArduPilot before public release.
APJ_BOARD_ID AP_HW_LEVIA_H7

OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 2048

# H743 flash sectors are 128 KiB. The bootloader occupies sector 0.
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 128

# USB-only bootloader for the first hardware test.
SERIAL_ORDER OTG1
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# Keep switched peripherals disabled and SPI devices deselected.
PE5 VTX_9V_EN OUTPUT LOW
PC15 IMU1_CS CS
PE11 IMU2_CS CS
PB12 OSD_CS CS
PD4 EXT_CS1 CS
PE2 EXT_CS2 CS

# LED0 is active low.
PE3 LED_BOOTLOADER OUTPUT HIGH
define HAL_LED_ON 0
