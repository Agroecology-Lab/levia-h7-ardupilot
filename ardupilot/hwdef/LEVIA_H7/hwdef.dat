# Minimal hardware definition for initial LEVIA H7 bring-up

MCU STM32H7xx STM32H743xx

# Provisional LEVIA H7 ID. Reserve this ID in ArduPilot before public release.
APJ_BOARD_ID AP_HW_LEVIA_H7

OSCILLATOR_HZ 8000000
FLASH_SIZE_KB 2048

# Reserve the first H743 flash sector for the bootloader.
FLASH_RESERVE_START_KB 128

STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

# USB is the primary bring-up link. UART7 remains SERIAL1 and the dedicated
# full-duplex RC connector on USART6 is exposed as SERIAL2 for CRSF/ELRS.
SERIAL_ORDER OTG1 UART7 USART6 USART2 USART1
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD
PE7 UART7_RX UART7
PE8 UART7_TX UART7
PC7 USART6_RX USART6
PC6 USART6_TX USART6
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_RCIN

# UART2 - GPS
PD5 USART2_TX USART2
PD6 USART2_RX USART2
define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_GPS

# UART1 - IRC Tramp control for the analog video transmitter on U10.
# Only TX is routed to the connector; this permits commands to the VTX but
# cannot receive Tramp replies from it.
PA9 USART1_TX USART1
PA10 USART1_RX USART1
define DEFAULT_SERIAL4_PROTOCOL SerialProtocol_Tramp

# Define one genuine board ADC input so ChibiOS assigns the ADC DMA stream.
PC0 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC1 BATT_CURRENT_SENS ADC1 SCALE(1)

# On-board VBAT divider: 10k high-side and 1k low-side (11:1).
# MicoAir AM32 4-in-1 ESC current output: 12.75mV/A = 78.431A/V.
define HAL_BATT_MONITOR_DEFAULT 4
define HAL_BATT_VOLT_PIN 10
define HAL_BATT_CURR_PIN 11
define HAL_BATT_VOLT_SCALE 11.0
define HAL_BATT_CURR_SCALE 78.431

DMA_PRIORITY S*

# Sensor buses. Package pin 9 is BMI270 INT2. It is unused by the native
# ArduPilot backend, so leave the connected MCU pins as high-impedance inputs.
PD14 BMI270_1_INT2 INPUT
PD15 BMI270_2_INT2 INPUT

PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PD7 SPI1_MOSI SPI1
PC15 IMU1_CS CS
PB2 IMU1_DRDY INPUT

PE12 SPI4_SCK SPI4
PE13 SPI4_MISO SPI4
PE14 SPI4_MOSI SPI4
PE11 IMU2_CS CS
PE15 IMU2_DRDY INPUT

I2C_ORDER I2C2 I2C1
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

# Onboard microSD card, matching the Matek H743 SDMMC1 pin assignment.
PC8 SDMMC1_D0 SDMMC1
PC9 SDMMC1_D1 SDMMC1
PC10 SDMMC1_D2 SDMMC1
PC11 SDMMC1_D3 SDMMC1
PC12 SDMMC1_CK SDMMC1
PD2 SDMMC1_CMD SDMMC1
define HAL_OS_FATFS_IO 1

# Motor outputs. These match the LEVIA MCU nets and the Matek H743 timer
# allocation, including the complementary TIM8 channels used by outputs 1-2.
PB0  TIM8_CH2N TIM8 PWM(1) GPIO(50)
PB1  TIM8_CH3N TIM8 PWM(2) GPIO(51)
PA0  TIM5_CH1  TIM5 PWM(3) GPIO(52)
PA1  TIM5_CH2  TIM5 PWM(4) GPIO(53)
PA2  TIM5_CH3  TIM5 PWM(5) GPIO(54)
PA3  TIM5_CH4  TIM5 PWM(6) GPIO(55)
PD12 TIM4_CH1  TIM4 PWM(7) GPIO(56)
PD13 TIM4_CH2  TIM4 PWM(8) GPIO(57)

SPIDEV bmi270_1 SPI1 DEVID1 IMU1_CS MODE3 1*MHZ 10*MHZ
SPIDEV bmi270_2 SPI4 DEVID1 IMU2_CS MODE3 1*MHZ 10*MHZ

# AT7456E analog OSD between U11 camera input and U10 VTX output.
PB12 OSD_CS CS
PB13 SPI2_SCK SPI2
PB14 SPI2_MISO SPI2
PB15 SPI2_MOSI SPI2
SPIDEV osd SPI2 DEVID4 OSD_CS MODE0 10*MHZ 10*MHZ
define OSD_ENABLED 1
define HAL_OSD_TYPE_DEFAULT 1
ROMFS_WILDCARD libraries/AP_OSD/fonts/font*.bin

DMA_NOSHARE SPI1* SPI4*

# Use ArduPilot's native BMI270 FIFO backend. IMU2 is physically rotated 90
# degrees counter-clockwise relative to IMU1, so retain the established board
# rotations and verify them from the two native sensor streams during bring-up.
IMU BMI270 SPI:bmi270_1 ROTATION_NONE
IMU BMI270 SPI:bmi270_2 ROTATION_YAW_90
define HAL_DEFAULT_INS_FAST_SAMPLE 1

# DPS368 is supported by the DPS310 backend. Both devices are on internal I2C2.
BARO DPS310 I2C:0:0x76
# Use only this explicit onboard probe so the generic IST8310 auto-probe
# cannot claim the device first with its default orientation.
define AP_COMPASS_IST8310_INTERNAL_BUS_PROBING_ENABLED 0
COMPASS IST8310 I2C:0:0x0E false ROTATION_ROLL_180
define HAL_I2C_INTERNAL_MASK 1
define AP_COMPASS_PROBING_ENABLED 1

# CAN1 (U13) through the U12 transceiver (1051-class). Pins from the
# LEVIA-H7 schematic/PCB: PD0 -> CAN1.RX, PD1 -> CAN1.TX, PD3 -> CAN1.SILENT
# (transceiver pin 8, S). Drive S low for normal mode. Close JP1 to add the
# onboard 120R termination.
PD0 CAN1_RX CAN1
PD1 CAN1_TX CAN1
PD3 GPIO_CAN1_SILENT OUTPUT PUSHPULL SPEED_LOW LOW GPIO(70)

# Switched 9V VTX rail. Relay 1 keeps it off by default and allows controlled
# enable only after an antenna is fitted to the transmitter.
PE5 VTX_9V_EN OUTPUT LOW GPIO(81)
define RELAY1_PIN_DEFAULT 81

# Board LEDs are active low.
define AP_NOTIFY_GPIO_LED_2_ENABLED 1
PE3 LED0 OUTPUT HIGH GPIO(90)
PE4 LED1 OUTPUT HIGH GPIO(91)
define HAL_GPIO_A_LED_PIN 91
define HAL_GPIO_B_LED_PIN 90

define HAL_STORAGE_SIZE 32768
STORAGE_FLASH_PAGE 14

env BUILD_ABIN True

# Hiwonder I2C encoder motor driver (needs ardupilot/patches applied)
define AP_HIWONDEREMM_ENABLED 1
