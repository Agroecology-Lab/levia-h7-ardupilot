+/*
+  Driver for the Hiwonder 4-channel encoder motor driver over I2C.
+
+  Product: https://www.hiwonder.com/products/4-channel-encoder-motor-driver
+
+  Ported from the PX4 hiwonder_emm driver. SERVO outputs selected by
+  SERVO_EMM_MASK are sent to the board as closed-loop speed commands.
+ */
+
+#pragma once
+
+#include <AP_HAL/AP_HAL_Boards.h>
+
+#ifndef AP_HIWONDEREMM_ENABLED
+#define AP_HIWONDEREMM_ENABLED 0
+#endif
+
+#if AP_HIWONDEREMM_ENABLED
+
+#include <AP_HAL/AP_HAL.h>
+#include <AP_HAL/I2CDevice.h>
+#include <AP_HAL/Semaphores.h>
+#include <AP_Param/AP_Param.h>
+
+class AP_HiwonderEMM {
+public:
+    AP_HiwonderEMM();
+
+    /* Do not allow copies */
+    CLASS_NO_COPY(AP_HiwonderEMM);
+
+    static AP_HiwonderEMM *get_singleton() { return _singleton; }
+
+    static const struct AP_Param::GroupInfo var_info[];
+
+    // called from SRV_Channels::push()
+    void update();
+
+    // called from AP_Arming, returns false if arming should be refused
+    bool pre_arm_check(char *failure_msg, const uint8_t failure_msg_len) const;
+
+    static constexpr uint8_t CHANNEL_COUNT = 4;
+
+private:
+    static AP_HiwonderEMM *_singleton;
+
+    // parameters
+    AP_Int32 motor_mask;
+    AP_Int8  bus;
+    AP_Int8  address;
+    AP_Int8  motor_type;
+    AP_Int8  encoder_polarity;
+
+    // main thread state
+    bool init_done;
+    bool invalid_mask;
+    uint8_t motor_count;
+    uint8_t servo_chan[CHANNEL_COUNT];
+    uint32_t last_log_ms;
+
+    void init();
+    static int8_t pwm_to_speed(uint16_t pwm);
+    void log_status();
+
+    // I2C thread state
+    AP_HAL::I2CDevice *dev;
+    void timer();
+    bool probe_and_configure();
+    bool read_adc(float &volts);
+    bool read_encoder_counts(int32_t counts[CHANNEL_COUNT]);
+    bool set_motor_speed(const int8_t speeds[CHANNEL_COUNT]);
+
+    bool configured;
+    bool set_speed_failed;
+    uint8_t tick;
+    uint16_t retry_ticks;
+
+    // values shared between threads, protected by sem
+    HAL_Semaphore sem;
+    int8_t target_speed[CHANNEL_COUNT];
+    uint32_t last_target_ms;
+    float battery_volts;
+    int32_t encoder_count[CHANNEL_COUNT];
+
+    // events raised on the I2C thread, reported from update()
+    enum : uint8_t {
+        EVENT_FOUND            = 1U << 0,
+        EVENT_WRITE_FAILED     = 1U << 1,
+        EVENT_WRITE_RECOVERED  = 1U << 2,
+    };
+    uint8_t pending_events;
+};
+
+namespace AP {
+    AP_HiwonderEMM *hiwonder_emm();
+};
+
+#endif  // AP_HIWONDEREMM_ENABLED
