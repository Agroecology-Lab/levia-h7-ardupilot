+
+#if AP_HIWONDEREMM_ENABLED
+
+#include <AP_HiwonderEMM/AP_HiwonderEMM.h>
+
+void AP_WheelEncoder_HiwonderEMM::update(void)
+{
+    auto *emm = AP::hiwonder_emm();
+    if (emm == nullptr) {
+        return;
+    }
+
+    int32_t count;
+    uint32_t time_ms;
+    if (!emm->get_encoder(_state.instance, count, time_ms)) {
+        return;
+    }
+
+    if (!have_zero) {
+        // the EMM keeps its totals while it is powered, so start from zero
+        // rather than reporting the board's history as a jump in distance
+        have_zero = true;
+        zero_count = count;
+        last_count = count;
+        last_time_ms = time_ms;
+        copy_state_to_frontend(0, 0, 0, time_ms);
+        return;
+    }
+
+    if (time_ms == last_time_ms) {
+        // no new reading since the last call
+        return;
+    }
+
+    total_ticks += abs(count - last_count);
+    last_count = count;
+    last_time_ms = time_ms;
+    copy_state_to_frontend(count - zero_count, total_ticks, 0, time_ms);
+}
+
+#endif  // AP_HIWONDEREMM_ENABLED
