+
+#if AP_HIWONDEREMM_ENABLED
+
+#include "WheelEncoder_Backend.h"
+
+/*
+  Wheel encoder backend reading the encoder totals of the Hiwonder 4-channel
+  encoder motor driver (AP_HiwonderEMM). WENC instance 0 reads EMM encoder 1,
+  instance 1 reads EMM encoder 2. Forward motion must count up, use
+  EMM_POL to fix the direction. Set WENC_CPR to the counts per wheel
+  revolution seen at the EMM, not the motor shaft.
+ */
+class AP_WheelEncoder_HiwonderEMM : public AP_WheelEncoder_Backend
+{
+public:
+    using AP_WheelEncoder_Backend::AP_WheelEncoder_Backend;
+
+    // update state
+    void update(void) override;
+
+private:
+    bool     have_zero;        // true once the first reading has been taken
+    int32_t  zero_count;       // EMM total at the first reading, so distance starts at zero
+    int32_t  last_count;       // EMM total at the previous reading
+    uint32_t last_time_ms;     // time of the previous reading
+    uint32_t total_ticks;      // sum of absolute count changes
+};
+
+#endif  // AP_HIWONDEREMM_ENABLED
