 #define EMM_I2C_CLOCK_HZ               400000
 #define EMM_UPDATE_PERIOD_US           20000   // 50Hz speed commands
-#define EMM_STATUS_EVERY_N_TICKS       5       // 10Hz ADC and encoder reads
+#define EMM_STATUS_EVERY_N_TICKS       5       // 10Hz ADC reads, encoders are read every tick
 #define EMM_RETRY_TICKS                50      // 1s between probe attempts
 #define EMM_TARGET_TIMEOUT_MS          200     // stop motors if update() stalls
 #define EMM_LOG_PERIOD_MS              100
@@ -216,6 +216,22 @@ void AP_HiwonderEMM::log_status()
 #endif
 }
 
+// get the latest cumulative encoder count for a motor (0 based) and the
+// time it was read. Returns false until the first successful read.
+bool AP_HiwonderEMM::get_encoder(uint8_t motor, int32_t &count, uint32_t &time_ms) const
+{
+    if (motor >= CHANNEL_COUNT) {
+        return false;
+    }
+    WITH_SEMAPHORE(sem);
+    if (!encoder_valid) {
+        return false;
+    }
+    count = encoder_count[motor];
+    time_ms = encoder_time_ms;
+    return true;
+}
+
 // called from AP_Arming
 bool AP_HiwonderEMM::pre_arm_check(char *failure_msg, const uint8_t failure_msg_len) const
 {
@@ -263,19 +279,26 @@ void AP_HiwonderEMM::timer()
     }
     set_motor_speed(speeds);
 
+    // encoder counts are read every tick (50Hz) so that AP_WheelEncoder
+    // can feed EKF3 with timely deltas. Rover sends zero change between
+    // fresh samples, so a slow read would look like standstill to the EKF.
+    int32_t counts[CHANNEL_COUNT];
+    const bool enc_ok = read_encoder_counts(counts);
+    const uint32_t enc_ms = AP_HAL::millis();
+    if (enc_ok) {
+        WITH_SEMAPHORE(sem);
+        memcpy(encoder_count, counts, sizeof(encoder_count));
+        encoder_time_ms = enc_ms;
+        encoder_valid = true;
+    }
+
     if (++tick >= EMM_STATUS_EVERY_N_TICKS) {
         tick = 0;
         float volts;
-        int32_t counts[CHANNEL_COUNT];
-        const bool adc_ok = read_adc(volts);
-        const bool enc_ok = read_encoder_counts(counts);
-        WITH_SEMAPHORE(sem);
-        if (adc_ok) {
+        if (read_adc(volts)) {
+            WITH_SEMAPHORE(sem);
             battery_volts = volts;
         }
-        if (enc_ok) {
-            memcpy(encoder_count, counts, sizeof(encoder_count));
-        }
     }
 }
 
